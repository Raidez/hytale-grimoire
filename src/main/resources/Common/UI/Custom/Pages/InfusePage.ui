$Common = "../Common.ui";

$Common.@Container {
    Anchor: (Width: 860, Height: 640, Top: 200);

    #Title {
        $Common.@Title { @Text = "Infuse"; }
    }

    #Content {
        LayoutMode: Top;

        Group {
            LayoutMode: Left;
            Anchor: (Height: 500);

            Group #WheelPanel {
                LayoutMode: Full;
                Anchor: (Width: 500);
                Background: #ff0000;
            }

            Group #SpellPanel {
                LayoutMode: TopScrolling;
                Anchor: (Width: 325);
                Padding: (Left: 20, Right: 10, Top: 100, Bottom: 100);
                ScrollbarStyle: $Common.@DefaultScrollbarStyle;
                Background: #0059ff;
            }
        }

        Group #ButtonPanel {
            LayoutMode: Center;
            Anchor: (Height: 70);
            Background: #36f324;
            
            $Common.@CancelTextButton #CancelButton {
                @Anchor = (Width: 120);
                @Text = "Cancel";
            }
            
            Group {
                Anchor: (Width: 10);
            }

            $Common.@TextButton #InfuseButton {
                @Anchor = (Width: 200);
                @Text = "Infuse";
            }
        }
    }
}
