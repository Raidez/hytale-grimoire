Button {
    LayoutMode: Left;
    Anchor: (Height: 50);
    Padding: (Full: 6);
    Style: (
        Hovered: (
            Background: #000000(0.2),
        )
    );

    ItemIcon #Icon {
        Anchor: (Width: 40, Height: 40);
    }

    Label #Name {
        Padding: (Horizontal: 10, Vertical: 5);
        Style: (RenderBold: true, VerticalAlignment: Center);
        FlexWeight: 1;
    }

    Label #Cost {
        Padding: (Horizontal: 10, Vertical: 5);
        Style: (TextColor: #ffffff(0.6), VerticalAlignment: Center);
    }
}
